# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com
NEXT_PUBLIC_CAL_USERNAME=promarketing
NEXT_PUBLIC_CAL_EVENT_SLUG=consultation
CAL_WEBHOOK_SECRET=

# Admin allow-list (comma-separated)
ALLOWED_ADMIN_EMAILS=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ElevenLabs — частният агент за тренировката
ELEVENLABS_TRAINER_AGENT_ID=

# Google tag — Google Ads conversions + GA4 + Consent Mode v2 банер.
# Докато и двете ID-та са празни, сайтът не зарежда нищо от Google и банерът не се показва.
# Google Ads ID на акаунта (Tools → Google tag), във вид AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# GA4 Measurement ID (Admin → Data streams), във вид G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Само етикетът след наклонената черта от „Event snippet": AW-123/ЕТИКЕТ → ЕТИКЕТ
# (празен етикет = тази конверсия не се праща)
# Записана среща (Cal.com bookingSuccessful)
NEXT_PUBLIC_GADS_LABEL_BOOKING=
# Попълнена лийд форма
NEXT_PUBLIC_GADS_LABEL_LEAD=
# Клик на tel: линк (обаждане)
NEXT_PUBLIC_GADS_LABEL_PHONE=

# Meta лийд webhook (app/api/webhooks/meta-leads)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Системен токен на Meta (page токенът се извлича от него — lib/meta/page-token.ts)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=106080979260944
# Партньорски страници → къде се препращат лийдовете им (JSON; лийдовете им НЕ влизат в нашия CRM).
# Тайната не е в картата — `token_env` сочи към отделен env с Bearer токена.
# META_PARTNER_FORWARD={"106532484251875":{"url":"https://ccgroup-crm.vercel.app/api/leads","token_env":"CCGROUP_LEADS_TOKEN","source":"Facebook реклама","label":"CCGroup · Ивайло Иванов"}}
META_PARTNER_FORWARD=
# Bearer токенът на ccgroup-crm (/api/leads), виж token_env горе
CCGROUP_LEADS_TOKEN=

# Resend (sendEmail + /api/crm/email-relay)
RESEND_API_KEY=
# „Име <адрес>“ на потвърдения домейн; релеят праща от sistema@<този домейн>
EMAIL_FROM=
EMAIL_REPLY_TO=
# По избор: изричен адрес на подателя за /api/crm/email-relay
EMAIL_RELAY_FROM_ADDRESS=
