# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cal.com
NEXT_PUBLIC_CAL_USERNAME=promarketing
NEXT_PUBLIC_CAL_EVENT_SLUG=consultation
CAL_WEBHOOK_SECRET=

# Admin allow-list (comma-separated)
ALLOWED_ADMIN_EMAILS=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ElevenLabs — частният агент за тренировката
ELEVENLABS_TRAINER_AGENT_ID=

# Google tag — Google Ads conversions + GA4 + Consent Mode v2 банер.
# Докато и двете ID-та са празни, сайтът не зарежда нищо от Google и банерът не се показва.
# Google Ads ID на акаунта (Tools → Google tag), във вид AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# GA4 Measurement ID (Admin → Data streams), във вид G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Само етикетът след наклонената черта от „Event snippet": AW-123/ЕТИКЕТ → ЕТИКЕТ
# (празен етикет = тази конверсия не се праща)
# Записана среща (Cal.com bookingSuccessful)
NEXT_PUBLIC_GADS_LABEL_BOOKING=
# Попълнена лийд форма
NEXT_PUBLIC_GADS_LABEL_LEAD=
# Клик на tel: линк (обаждане)
NEXT_PUBLIC_GADS_LABEL_PHONE=
